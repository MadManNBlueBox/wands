      "_id": "vtUuyrGTs6mTRQCj",
      "name": "Kiss",
      "type": "feat",
      "img": "icons/magic/air/wind-vortex-swirl-purple.webp",
      "effects": [],
      "folder": null,
      "sort": 0,
      "flags": {
        "core": {}
